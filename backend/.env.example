# CropGuard AI Backend Environment Configuration

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="CropGuard AI Backend"

# Supabase Credentials (from your Supabase Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# If backend tasks require privileged service-role credentials, configure locally only:
SUPABASE_SERVICE_ROLE_KEY=

# ML Model Configuration
MODEL_PATH=ml/weights/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
