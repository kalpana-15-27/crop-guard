# Root .gitignore for CropGuard AI

# Environment & Credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/ios/Podfile.lock
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/App.framework
mobile/ios/Flutter/Generated.xcconfig

# Machine Learning & Large Artifacts
ml/dataset/raw/*
!ml/dataset/raw/.gitkeep
ml/dataset/processed/*
!ml/dataset/processed/.gitkeep
ml/weights/runs/*
ml/weights/*.pt
!ml/weights/best.pt
!ml/weights/.gitkeep
*.onnx

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
